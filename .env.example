NEXT_PUBLIC_SITE_URL=https://staicha.co.uk
ADMIN_USERNAME=staicha_admin
ADMIN_PASSWORD=change-me
CONTACT_EMAIL=contact@staicha.com

# Local development only. When admin creds aren't configured, set this to "true"
# to allow access to /admin and /api/admin without basic auth. Production deploys
# must leave it unset.
# DEV_ALLOW_OPEN_ADMIN=true

# Optional. If set, form submissions are delivered by Resend instead of
# being persisted to ./submissions and logged.
# RESEND_API_KEY=
# MAIL_FROM="Staicha Website <noreply@staicha.co.uk>"
